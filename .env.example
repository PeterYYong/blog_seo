# Naver Search Ads API
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_CUSTOMER_ID=

# NAVER API HUB (recommended/current): Search API + Search Trend
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Legacy Naver Developers credentials (only for keys issued before 2026-07-31;
# supported by Naver until 2027-06-30). Leave blank when using API HUB.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 (optional but recommended)
YOUTUBE_API_KEY=

# Kakao Developers: Daum Cafe Search (optional Korean community source)
KAKAO_REST_API_KEY=

# Reddit Data API (approval is required before enabling)
REDDIT_API_APPROVED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=blog-seo-workflow/1.0 by your-reddit-username

# X API v2 recent search (pay-per-use)
X_BEARER_TOKEN=

# Threads keyword search (token must have threads_keyword_search permission)
THREADS_KEYWORD_SEARCH_ENABLED=false
THREADS_ACCESS_TOKEN=

# Stack Exchange (optional; anonymous access works with a lower quota)
STACKEXCHANGE_KEY=

# OpenAI Secure MCP Tunnel (required only for private always-on cloud deployment)
# Create these in OpenAI Platform. Never use an organization admin key here.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# MCP server
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
